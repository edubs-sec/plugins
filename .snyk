# Snyk policy file
# https://docs.snyk.io/snyk-cli/commands/ignore

# Secrets-scanning exclusions.
#
# Every path below holds placeholder credentials by design, not real secrets.
# Snyk Secrets flags them as generic-secret/private-key false positives.
#
# Scoped to the `secrets` product rather than `global` so that Snyk Code (SAST)
# still scans these paths.
#
# Note: these are exclusions, not per-finding ignores. Snyk Secrets findings
# cannot currently be ignored individually -- `snyk ignore create` (Consistent
# Ignores) is Snyk Code only, and the IDE plugins send the rule ID instead of a
# finding UUID, failing with "Invalid Finding ID format".
exclude:
  secrets:
    # Documentation showing example API keys and tokens.
    - plugins/*/help.md
    # Plugin specs with example connection/input values.
    - plugins/*/plugin.spec.yaml
    # Unit-test fixtures containing dummy credentials.
    - plugins/*/unit_test/**
    # Auto-generated schemas (regenerated by `insight-plugin refresh`);
    # these declare field names such as PASSWORD = "password".
    - plugins/*/icon_*/actions/*/schema.py
